DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dineflow"
JWT_SECRET="dev-secret-change-me-please-32chars-min"
PAYMENT_GATEWAY="mock"
MESSAGE_PROVIDER="mock"
AI_PROVIDER="off"            # set to "anthropic" + ANTHROPIC_API_KEY to turn AI explanations on
AI_MODEL="claude-opus-5-5"
ANTHROPIC_API_KEY=""
APP_TZ="Asia/Kolkata"
DEMO_LOGIN="0"            # dev only: 1 enables /api/auth/demo for screenshots
